# Copy to `.env` for local dev. On Vercel, set these two as Environment
# Variables instead (Project Settings -> Environment Variables).
#
# Both values come from the same Supabase project the Flutter app uses:
#   Supabase dashboard -> Project Settings -> API
#
# The VITE_ prefix is required — Vite only exposes prefixed vars to the browser.

VITE_SUPABASE_URL=

# The "anon public" key (a long JWT starting with eyJ...).
# This is the ONLY Supabase key that belongs in a browser bundle.
# Never put the service_role key here — it bypasses Row Level Security.
VITE_SUPABASE_ANON_KEY=
